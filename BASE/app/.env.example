# Copy this file to .env. Fill each value locally; never commit .env or paste secrets into chat.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Generate a unique random secret of at least 32 bytes.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# PostgreSQL used only for creating backups.
BACKUP_DATABASE_URL=postgresql://postgres:REPLACE_ME@db:5432/acredittia
# PostgreSQL maintenance connection used only by restore operations.
BACKUP_RESTORE_DATABASE_URL=postgresql://postgres:REPLACE_ME@db:5432/acredittia
# Generate exactly 32 random bytes and encode them as URL-safe Base64, e.g.
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_URL_SAFE_BASE64_OF_32_BYTES
